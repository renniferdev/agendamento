DATABASE_URL=
RESEND_API_KEY=
# Remetente dos e-mails de agendamento. Sem domínio verificado no Resend, deixe
# vazio (usa onboarding@resend.dev, que só entrega para o e-mail do dono da conta).
EMAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Secret do JWT de sessão do cliente final (separado do Auth.js do admin).
# Gere com: openssl rand -base64 32
CUSTOMER_JWT_SECRET=

# Origem do front-end (CORS + redirect pos-login do Auth.js)
FRONTEND_URL=

# E-mail do dono da plataforma (unico que acessa /plataforma). Exige login Google.
PLATFORM_ADMIN_EMAIL=
